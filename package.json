{
  "name": "next-advanced-sitemap",
  "version": "2.0.0",
  "type": "module",
  "description": "Advanced sitemap generator for Next.js. Streaming XML, strict mode, deletion/expiration lifecycle, route auto-scanning, IndexNow, and full Google Images/Video/News/Hreflang support. Type-safe and built for App Router.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scanner": {
      "import": {
        "types": "./dist/scanner.d.ts",
        "default": "./dist/scanner.js"
      },
      "require": {
        "types": "./dist/scanner.d.cts",
        "default": "./dist/scanner.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "size": "size-limit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "nextjs",
    "sitemap",
    "seo",
    "google-images",
    "google-video",
    "google-news",
    "hreflang",
    "multilingual",
    "typescript",
    "app-router",
    "streaming",
    "indexnow",
    "robots-txt"
  ],
  "author": "fomadev",
  "license": "FomaDev Public License",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fomadev/next-advanced-sitemap.git"
  },
  "bugs": {
    "url": "https://github.com/fomadev/next-advanced-sitemap/issues"
  },
  "homepage": "https://github.com/fomadev/next-advanced-sitemap#readme",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.1.0",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "40 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "40 KB"
    },
    {
      "path": "dist/scanner.js",
      "limit": "8 KB",
      "ignore": ["node:fs", "node:path", "fs", "path"]
    },
    {
      "path": "dist/scanner.cjs",
      "limit": "8 KB",
      "ignore": ["node:fs", "node:path", "fs", "path"]
    }
  ],
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  }
}
